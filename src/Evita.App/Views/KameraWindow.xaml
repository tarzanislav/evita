<Window x:Class="Evita.Views.KameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kamera – skenovanie kódov"
        Width="760" Height="640" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="True">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="Zavriet" DockPanel.Dock="Right" Content="Zavrieť" Padding="14,5" Margin="8,0,0,0" Click="Zavriet_Click" />
            <ComboBox x:Name="Kamery" DisplayMemberPath="Nazov" SelectionChanged="Kamery_SelectionChanged" MinWidth="240" />
        </DockPanel>

        <Border x:Name="Vysledok" DockPanel.Dock="Bottom" CornerRadius="6" Padding="14,10" Margin="0,10,0,0"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <TextBlock x:Name="VysledokText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Podržte čiarový alebo QR kód pred kamerou, asi 10 až 20 cm od nej." />
        </Border>

        <Border Background="Black" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Image x:Name="Obraz" Stretch="Uniform" />
                <Border Width="260" Height="170" BorderBrush="#AAFFFFFF" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False" />
                <TextBlock x:Name="Stav" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" Text="Zapínam kameru…" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
