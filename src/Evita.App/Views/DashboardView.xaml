<UserControl x:Class="Evita.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Dlazdica" TargetType="Border" BasedOn="{StaticResource Karta}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="96" />
        </Style>
        <ControlTemplate x:Key="BezRamceka" TargetType="Button">
            <ContentPresenter />
        </ControlTemplate>
        <Style x:Key="MaleTlacidlo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OdkazUpozornenia" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Dnešný deň -->
            <Border Style="{StaticResource Karta}" Margin="0,0,12,12"
                    Visibility="{Binding UkazDnes, Converter={StaticResource BoolNaViditelnost}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DatumText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TyzdenText}" Style="{StaticResource Popis}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CasText}" FontSize="36" FontWeight="Light" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Meniny" Style="{StaticResource Popis}" />
                        <TextBlock Text="{Binding MeninyDnes}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Popis}" Margin="0,4,0,0">
                            <Run Text="Zajtra:" /> <Run Text="{Binding MeninyZajtra, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding MeninyOsob}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="{Binding MeninyOsob, Converter={StaticResource NieJePrazdne}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Sviatky" Style="{StaticResource Popis}" />
                        <Border CornerRadius="4" Padding="8,2" Margin="0,2,0,4" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding JeDnesVolno, Converter={StaticResource BoolNaViditelnost}}">
                            <TextBlock Text="Dnes je deň pracovného pokoja" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding SviatokDnes}" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Visibility="{Binding SviatokDnes, Converter={StaticResource NieJePrazdne}}" />
                        <TextBlock Text="{Binding NajblizsiVolnyDen}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Button Content="Sviatky v roku…" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3"
                                Command="{Binding OtvorSviatkyCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Úlohy, počasie, kurzový lístok -->
            <UniformGrid Rows="1">
                <!-- Úlohy (To Do) -->
                <Border Style="{StaticResource Karta}" Margin="0,0,12,12"
                        Visibility="{Binding UkazUlohy, Converter={StaticResource BoolNaViditelnost}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaleTlacidlo}" Content="Všetky…"
                                    Command="{Binding OtvorUlohyCommand}" ToolTip="Otvoriť všetky úlohy" />
                            <TextBlock Text="Úlohy" Style="{StaticResource Podnadpis}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding UlohySuhrn}" Style="{StaticResource Popis}" Margin="0,2,0,8" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBox Text="{Binding NovaUloha, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding PridatUlohuCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Nová úloha – napíšte a stlačte Enter" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding NovaUloha, Converter={StaticResource NieJePrazdne}, ConverterParameter=opacne}" />
                        </Grid>
                        <Button DockPanel.Dock="Bottom" Template="{StaticResource BezRamceka}" Cursor="Hand" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Command="{Binding OtvorUlohyCommand}" Visibility="{Binding DalsieUlohy, Converter={StaticResource NieJePrazdne}}">
                            <TextBlock Text="{Binding DalsieUlohy}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Button>
                        <ItemsControl ItemsSource="{Binding Ulohy}" ItemTemplate="{StaticResource UlohaRiadok}" />
                    </DockPanel>
                </Border>

                <!-- Počasie -->
                <Border Style="{StaticResource Karta}" Margin="0,0,12,12"
                        Visibility="{Binding UkazPocasie, Converter={StaticResource BoolNaViditelnost}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource MaleTlacidlo}" Command="{Binding ObnovitZoSieteCommand}" ToolTip="Obnoviť počasie a kurzy">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE72C;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource MaleTlacidlo}" Command="{Binding OtvorNastaveniaCommand}" ToolTip="Zmeniť miesto">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE713;" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Počasie" Style="{StaticResource Podnadpis}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0"
                                    Visibility="{Binding JeMiestoPocasia, Converter={StaticResource InverzBoolNaViditelnost}}">
                            <TextBlock Text="{Binding PocasieStav}" Style="{StaticResource Popis}" FontSize="13" />
                            <Button Content="Nastaviť miesto…" HorizontalAlignment="Left" Padding="12,4" Margin="0,10,0,0"
                                    Command="{Binding OtvorNastaveniaCommand}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Visibility="{Binding JePocasie, Converter={StaticResource BoolNaViditelnost}}">
                            <TextBlock Text="{Binding Pocasie.Miesto.Nazov}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Pocasie.Miesto.Popis}" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Pocasie.Symbol}" FontSize="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Pocasie.TeplotaText}" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Pocasie.Popis}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Popis}" Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding Pocasie.PocitovaText, Mode=OneWay}" />
                                <Run Text="·" /> <Run Text="{Binding Pocasie.VlhkostText, Mode=OneWay}" />
                                <Run Text="·" /> <Run Text="{Binding Pocasie.VietorText, Mode=OneWay}" />
                                <Run Text="{Binding Pocasie.ZrazkyText, Mode=OneWay}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Pocasie.Dni}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" ToolTip="{Binding Popis}">
                                            <TextBlock Text="{Binding Den}" FontSize="11.5" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Symbol}" FontSize="20" HorizontalAlignment="Center"
                                                       FontFamily="Segoe UI Emoji, Segoe UI Symbol" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="12">
                                                <Run Text="{Binding MaxText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding MinText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ZrazkyText}" FontSize="10.5" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PocasieAktualizovane}" Style="{StaticResource Popis}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding PocasieStav}" Style="{StaticResource Popis}" Margin="0,6,0,0"
                                   Visibility="{Binding JeMiestoPocasia, Converter={StaticResource BoolNaViditelnost}}" />
                    </DockPanel>
                </Border>

                <!-- Kurzový lístok -->
                <Border Style="{StaticResource Karta}" Margin="0,0,12,12"
                        Visibility="{Binding UkazKurzy, Converter={StaticResource BoolNaViditelnost}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource MaleTlacidlo}" Command="{Binding ObnovitZoSieteCommand}" ToolTip="Obnoviť počasie a kurzy">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE72C;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource MaleTlacidlo}" Command="{Binding OtvorNastaveniaCommand}" ToolTip="Vybrať meny">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE713;" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Kurzový lístok" Style="{StaticResource Podnadpis}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding KurzyDatum}" Style="{StaticResource Popis}" Margin="0,2,0,6" />

                        <!-- prepočet -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="50" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding SumaPrepoctu, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" ToolTip="Suma na prepočet" />
                            <ComboBox Grid.Column="1" Width="78" Margin="4,0,0,0" ItemsSource="{Binding MenyPrepoctu}" SelectedItem="{Binding MenaZ}" />
                            <Button Grid.Column="2" Style="{StaticResource MaleTlacidlo}" Command="{Binding VymenitMenyCommand}" ToolTip="Vymeniť meny">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE8AB;" FontSize="12" />
                            </Button>
                            <ComboBox Grid.Column="3" Width="78" Margin="4,0,0,0" ItemsSource="{Binding MenyPrepoctu}" SelectedItem="{Binding MenaNa}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding VysledokPrepoctu, StringFormat='= {0}'}" FontWeight="SemiBold" FontSize="15"
                                       Margin="0,6,0,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding VysledokPrepoctu, Converter={StaticResource NieJePrazdne}}" />
                        </Grid>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding KurzyStav}" Style="{StaticResource Popis}" Margin="0,4,0,0"
                                   Visibility="{Binding KurzyStav, Converter={StaticResource NieJePrazdne}}" />

                        <ItemsControl ItemsSource="{Binding Kurzy}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1" ToolTip="{Binding Nazov}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kod}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Polyline Grid.Column="1" Points="{Binding Historia, Converter={StaticResource HodnotyNaKrivku}}"
                                                  Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.3"
                                                  Width="60" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,6,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding KurzText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Zmena" Grid.Column="3" Text="{Binding ZmenaText}" FontSize="11.5" MinWidth="72"
                                                   TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Rastie}" Value="True">
                                            <Setter TargetName="Zmena" Property="Foreground" Value="#2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Klesa}" Value="True">
                                            <Setter TargetName="Zmena" Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Pripnuté poznámky -->
            <Border Style="{StaticResource Karta}" Margin="0,0,12,12"
                    Visibility="{Binding UkazPoznamky, Converter={StaticResource BoolNaViditelnost}}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Nová poznámka" Padding="10,3" Command="{Binding NovaPoznamkaCommand}" />
                            <Button Content="Všetky poznámky…" Padding="10,3" Margin="6,0,0,0" Command="{Binding OtvorPoznamkuCommand}" />
                        </StackPanel>
                        <TextBlock Text="Pripnuté poznámky" Style="{StaticResource Podnadpis}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Žiadne pripnuté poznámky. Dôležitú poznámku pripnete špendlíkom v časti Poznámky." Style="{StaticResource Popis}"
                               Margin="0,8,0,0" Visibility="{Binding PripnutePoznamky.Count, Converter={StaticResource NulaNaViditelnost}}" />
                    <ItemsControl ItemsSource="{Binding PripnutePoznamky}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Template="{StaticResource BezRamceka}" Cursor="Hand" Margin="0,0,10,10"
                                        Command="{Binding DataContext.OtvorPoznamkuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Width="210" Height="104" CornerRadius="6" Padding="10,8"
                                            Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.18" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" Foreground="#1B1B1B" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Text}" Foreground="#3A3A3A" FontSize="12" TextWrapping="Wrap" MaxHeight="64"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Kalendár -->
            <Border Style="{StaticResource Karta}" Margin="0,0,12,12"
                    Visibility="{Binding UkazKalendar, Converter={StaticResource BoolNaViditelnost}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding NazovMesiaca}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <UniformGrid Columns="7" Margin="0,0,0,2">
                            <TextBlock Text="Po" Style="{StaticResource Popis}" HorizontalAlignment="Center" />
                            <TextBlock Text="Ut" Style="{StaticResource Popis}" HorizontalAlignment="Center" />
                            <TextBlock Text="St" Style="{StaticResource Popis}" HorizontalAlignment="Center" />
                            <TextBlock Text="Št" Style="{StaticResource Popis}" HorizontalAlignment="Center" />
                            <TextBlock Text="Pi" Style="{StaticResource Popis}" HorizontalAlignment="Center" />
                            <TextBlock Text="So" Style="{StaticResource Popis}" HorizontalAlignment="Center" />
                            <TextBlock Text="Ne" Style="{StaticResource Popis}" HorizontalAlignment="Center" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding MiniKalendar}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Den" Height="28" Margin="1" CornerRadius="4">
                                        <Grid>
                                            <TextBlock x:Name="Cislo" Text="{Binding Cislo}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                            <Ellipse x:Name="Bodka" Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                     VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Vikend}" Value="True">
                                            <Setter TargetName="Den" Property="Background" Value="#10808080" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Volno}" Value="True">
                                            <Setter TargetName="Den" Property="Background" Value="#304CAF50" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MaUdalost}" Value="True">
                                            <Setter TargetName="Bodka" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MimoMesiaca}" Value="True">
                                            <Setter TargetName="Cislo" Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dnes}" Value="True">
                                            <Setter TargetName="Den" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Cislo" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            <Setter TargetName="Cislo" Property="FontWeight" Value="Bold" />
                                            <Setter TargetName="Bodka" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dnes a najbližších 7 dní" Style="{StaticResource Podnadpis}" />
                        <TextBlock Text="{Binding KalendarSuhrn}" Style="{StaticResource Popis}" Margin="0,-4,0,8" />
                        <ItemsControl ItemsSource="{Binding NajblizsieUdalosti}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="8,3" CornerRadius="3" BorderThickness="3,0,0,0"
                                            BorderBrush="{Binding Farba, Converter={StaticResource FarbaNaStetec}}"
                                            Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=18}">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Zaciatok, Mode=OneWay, StringFormat='ddd d. M.'}" FontWeight="SemiBold" />
                                            <Run Text="{Binding CasText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Run Text="{Binding Nazov, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Otvoriť kalendár…" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                                Command="{Binding OtvorKalendarCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Úlohy po termíne" Style="{StaticResource Podnadpis}" />
                        <TextBlock Text="Žiadna úloha nie je po termíne." Style="{StaticResource Popis}"
                                   Visibility="{Binding UlohyPoTermine.Count, Converter={StaticResource NulaNaViditelnost}}" />
                        <ItemsControl ItemsSource="{Binding UlohyPoTermine}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                        <Run Text="{Binding Zaciatok, Mode=OneWay, StringFormat='d. M.'}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Run Text="{Binding Nazov, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Počty -->
            <UniformGrid Columns="4" Visibility="{Binding UkazPocty, Converter={StaticResource BoolNaViditelnost}}">
                <Border Style="{StaticResource Dlazdica}">
                    <StackPanel>
                        <TextBlock Text="Položky v evidencii" Style="{StaticResource Popis}" />
                        <TextBlock Text="{Binding PocetAktivnych}" Style="{StaticResource VelkeCislo}" />
                        <TextBlock Style="{StaticResource Popis}">
                            <Run Text="vyradených:" /> <Run Text="{Binding PocetVyradenych, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Dlazdica}">
                    <StackPanel>
                        <TextBlock Text="Miestnosti" Style="{StaticResource Popis}" />
                        <TextBlock Text="{Binding PocetMiestnosti}" Style="{StaticResource VelkeCislo}" />
                        <TextBlock Style="{StaticResource Popis}">
                            <Run Text="kategórií:" /> <Run Text="{Binding PocetKategorii, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Dlazdica}">
                    <StackPanel>
                        <TextBlock Text="Osoby" Style="{StaticResource Popis}" />
                        <TextBlock Text="{Binding PocetOsob}" Style="{StaticResource VelkeCislo}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Dlazdica}">
                    <StackPanel>
                        <TextBlock Text="Pridané tento mesiac" Style="{StaticResource Popis}" />
                        <TextBlock Text="{Binding PridaneMesiac}" Style="{StaticResource VelkeCislo}" />
                        <TextBlock Style="{StaticResource Popis}">
                            <Run Text="tento rok:" /> <Run Text="{Binding PridaneRok, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Graf: položky podľa kategórií -->
                <Border Grid.Column="0" Style="{StaticResource Karta}" Margin="0,0,12,12"
                        Visibility="{Binding UkazGraf, Converter={StaticResource BoolNaViditelnost}}">
                    <StackPanel>
                        <TextBlock Text="Položky podľa kategórií" Style="{StaticResource Podnadpis}" />
                        <TextBlock Text="Zatiaľ žiadne položky." Style="{StaticResource Popis}"
                                   Visibility="{Binding Graf.Count, Converter={StaticResource NulaNaViditelnost}}" />
                        <ItemsControl ItemsSource="{Binding Graf}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OdkazUpozornenia}" Margin="0,0,0,3" Padding="8,4"
                                            Command="{Binding DataContext.OtvorKategoriuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Kliknutím zobrazíte položky tejto kategórie">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Nazov}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Height="12" Minimum="0" VerticalAlignment="Center"
                                                         Maximum="{Binding Maximum, Mode=OneWay}" Value="{Binding Pocet, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Pocet}" TextAlignment="Right"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Popis}" Margin="0,6,0,0" Text="Bez vyradených položiek." />
                    </StackPanel>
                </Border>

                <!-- Upozornenia -->
                <Border Grid.Column="1" Style="{StaticResource Karta}" Margin="0,0,12,12" VerticalAlignment="Top"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2"
                        Visibility="{Binding UkazUpozornenia, Converter={StaticResource BoolNaViditelnost}}">
                    <StackPanel>
                        <TextBlock Text="Upozornenia" Style="{StaticResource Podnadpis}" />
                        <TextBlock Text="Všetko je v poriadku, nič netreba riešiť." Style="{StaticResource Popis}"
                                   Visibility="{Binding ZiadneUpozornenia, Converter={StaticResource BoolNaViditelnost}}" />
                        <Button Style="{StaticResource OdkazUpozornenia}"
                                Command="{Binding OtvorEvidenciuCommand}" CommandParameter="zaruky">
                            <TextBlock>
                                <Run Text="Záruka končí do 30 dní:" /> <Run Text="{Binding ZarukyDo30, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource OdkazUpozornenia}"
                                Command="{Binding OtvorEvidenciuCommand}" CommandParameter="revizie">
                            <TextBlock>
                                <Run Text="Revízia do 30 dní alebo po termíne:" /> <Run Text="{Binding RevizieDo30, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource OdkazUpozornenia}"
                                Command="{Binding OtvorEvidenciuCommand}" CommandParameter="oprava">
                            <TextBlock>
                                <Run Text="V oprave:" /> <Run Text="{Binding VOprave, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource OdkazUpozornenia}"
                                Command="{Binding OtvorEvidenciuCommand}" CommandParameter="bezMiestnosti">
                            <TextBlock>
                                <Run Text="Bez miestnosti:" /> <Run Text="{Binding BezMiestnosti, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource OdkazUpozornenia}"
                                Command="{Binding OtvorEvidenciuCommand}" CommandParameter="bezPridelenia">
                            <TextBlock>
                                <Run Text="Bez pridelenia osobe:" /> <Run Text="{Binding BezPridelenia, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource OdkazUpozornenia}" Command="{Binding OtvorServisCommand}">
                            <StackPanel>
                                <TextBlock Text="{Binding ZalohaText}" TextWrapping="Wrap" />
                                <TextBlock Text="Zálohu treba urobiť – kliknite sem." FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding ZalohaVarovanie, Converter={StaticResource BoolNaViditelnost}}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Popis}" Margin="0,6,0,0"
                                   Text="Kliknutím otvoríte zoznam príslušných položiek alebo servis záloh." />
                    </StackPanel>
                </Border>

            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Naposledy -->
                <Border Grid.Column="0" Style="{StaticResource Karta}" Margin="0,0,12,12"
                        Visibility="{Binding UkazNaposledy, Converter={StaticResource BoolNaViditelnost}}">
                    <StackPanel>
                        <TextBlock Text="Naposledy pridané" Style="{StaticResource Podnadpis}" />
                        <ItemsControl ItemsSource="{Binding NaposledyPridane}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding PrirastkoveCislo, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Nazov, Mode=OneWay}" />
                                        <Run Text="{Binding DatumPridania, Mode=OneWay, StringFormat='· d. M. yyyy'}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Naposledy zmenené" Style="{StaticResource Podnadpis}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding NaposledyZmenene}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding PrirastkoveCislo, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Nazov, Mode=OneWay}" />
                                        <Run Text="{Binding DatumZmeny, Mode=OneWay, StringFormat='· d. M. yyyy H:mm'}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- O databáze -->
                <Border Grid.Column="1" Style="{StaticResource Karta}" Margin="0,0,12,12" VerticalAlignment="Top"
                        Visibility="{Binding UkazDatabazu, Converter={StaticResource BoolNaViditelnost}}">
                    <StackPanel>
                        <TextBlock Text="O programe a databáze" Style="{StaticResource Podnadpis}" />
                        <TextBlock Text="{Binding VerziaProgramu}" TextWrapping="Wrap" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="Veľkosť databázy:" /> <Run Text="{Binding VelkostDatabazy, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding PoslednaKontrola}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding KalendariumText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Button Content="Servis…" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3"
                                Command="{Binding OtvorServisCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Popis}" Margin="0,0,12,8"
                       Text="Citát dňa a výročia osobností pribudnú v etape 7." />

            <Expander Header="Prispôsobiť dashboard" Margin="0,0,12,12">
                <WrapPanel Margin="8">
                    <CheckBox Content="Dnešný deň" IsChecked="{Binding UkazDnes}" Margin="0,0,16,6" />
                    <CheckBox Content="Úlohy" IsChecked="{Binding UkazUlohy}" Margin="0,0,16,6" />
                    <CheckBox Content="Počasie" IsChecked="{Binding UkazPocasie}" Margin="0,0,16,6" />
                    <CheckBox Content="Kurzový lístok" IsChecked="{Binding UkazKurzy}" Margin="0,0,16,6" />
                    <CheckBox Content="Pripnuté poznámky" IsChecked="{Binding UkazPoznamky}" Margin="0,0,16,6" />
                    <CheckBox Content="Kalendár" IsChecked="{Binding UkazKalendar}" Margin="0,0,16,6" />
                    <CheckBox Content="Počty" IsChecked="{Binding UkazPocty}" Margin="0,0,16,6" />
                    <CheckBox Content="Položky podľa kategórií" IsChecked="{Binding UkazGraf}" Margin="0,0,16,6" />
                    <CheckBox Content="Upozornenia" IsChecked="{Binding UkazUpozornenia}" Margin="0,0,16,6" />
                    <CheckBox Content="Naposledy pridané a zmenené" IsChecked="{Binding UkazNaposledy}" Margin="0,0,16,6" />
                    <CheckBox Content="O programe a databáze" IsChecked="{Binding UkazDatabazu}" Margin="0,0,16,6" />
                </WrapPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
