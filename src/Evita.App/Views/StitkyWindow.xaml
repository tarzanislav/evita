<Window x:Class="Evita.Views.StitkyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Štítky s QR kódom"
        Width="1180" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Volba" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,12,2" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- nastavenia -->
        <Border DockPanel.Dock="Left" Width="380" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16">
                    <Button Style="{DynamicResource AccentButtonStyle}" Padding="14,7" HorizontalAlignment="Stretch" Command="{Binding VytlacitCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE749;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Vytlačiť…" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Padding="10,6" HorizontalAlignment="Stretch" Command="{Binding UlozitPdfCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xEA90;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Uložiť ako PDF…" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Content="Zavrieť" Padding="10,6" HorizontalAlignment="Stretch" IsCancel="True" />
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,8">
                        <TextBlock Text="Štítky" Style="{StaticResource Podnadpis}" FontSize="20" />
                        <TextBlock Text="{Binding PopisVyberu}" Style="{StaticResource Popis}" FontSize="13" />

                        <TextBlock Text="Formát štítkov" Style="{StaticResource Stitok}" Margin="0,14,0,4" />
                        <ComboBox ItemsSource="{Binding Sablony}" DisplayMemberPath="Nazov" SelectedItem="{Binding Sablona}" />
                        <TextBlock Text="{Binding RozmerText}" Style="{StaticResource Popis}" Margin="0,4,0,0" />

                        <!-- vlastný formát -->
                        <Border Style="{StaticResource Karta}" Padding="12" Margin="0,8,0,0"
                                Visibility="{Binding JeVlastna, Converter={StaticResource BoolNaViditelnost}}">
                            <StackPanel>
                                <CheckBox Content="Hárok A4 (inak jeden štítok na stranu – tlačiareň štítkov)" IsChecked="{Binding VlastnyHarok}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Šírka štítku (mm)" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastnaSirka, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Výška štítku (mm)" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastnaVyska, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Visibility="{Binding JeHarok, Converter={StaticResource BoolNaViditelnost}}">
                                        <TextBlock Text="Stĺpce" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastneStlpce, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Visibility="{Binding JeHarok, Converter={StaticResource BoolNaViditelnost}}">
                                        <TextBlock Text="Riadky" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastneRiadky, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Visibility="{Binding JeHarok, Converter={StaticResource BoolNaViditelnost}}">
                                        <TextBlock Text="Okraj hore (mm)" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastnyOkrajHore, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Visibility="{Binding JeHarok, Converter={StaticResource BoolNaViditelnost}}">
                                        <TextBlock Text="Okraj vľavo (mm)" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastnyOkrajVlavo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Visibility="{Binding JeHarok, Converter={StaticResource BoolNaViditelnost}}">
                                        <TextBlock Text="Medzera vodorovne (mm)" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastnaMedzeraVodorovne, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2" Visibility="{Binding JeHarok, Converter={StaticResource BoolNaViditelnost}}">
                                        <TextBlock Text="Medzera zvisle (mm)" Style="{StaticResource Stitok}" />
                                        <TextBox Text="{Binding VlastnaMedzeraZvisle, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kód na štítku" Style="{StaticResource Stitok}" Margin="0,14,0,4" />
                        <ComboBox ItemsSource="{Binding Kody}" DisplayMemberPath="Nazov" SelectedValuePath="Kod" SelectedValue="{Binding Kod}" />
                        <StackPanel Visibility="{Binding MaKod, Converter={StaticResource BoolNaViditelnost}}">
                            <TextBlock Text="Obsah kódu" Style="{StaticResource Stitok}" />
                            <ComboBox ItemsSource="{Binding Obsahy}" DisplayMemberPath="Nazov" SelectedValuePath="Obsah" SelectedValue="{Binding ObsahKodu}" />
                            <TextBlock Style="{StaticResource Popis}" Margin="0,4,0,0"
                                       Text="Štítok EviTA nájde položku vždy jednoznačne. Inventárne alebo sériové číslo sa hodí, ak kódy čítate aj iným programom." />
                        </StackPanel>

                        <TextBlock Text="Text na štítku" Style="{StaticResource Stitok}" Margin="0,14,0,4" />
                        <WrapPanel>
                            <CheckBox Content="Názov organizácie" IsChecked="{Binding OrganizaciaNaStitku}" Style="{StaticResource Volba}" />
                            <CheckBox Content="Názov položky" IsChecked="{Binding Nazov}" Style="{StaticResource Volba}" />
                            <CheckBox Content="Prírastkové číslo" IsChecked="{Binding Cislo}" Style="{StaticResource Volba}" />
                            <CheckBox Content="Inventárne číslo" IsChecked="{Binding Inventarne}" Style="{StaticResource Volba}" />
                            <CheckBox Content="Sériové číslo" IsChecked="{Binding Seriove}" Style="{StaticResource Volba}" />
                            <CheckBox Content="Miestnosť" IsChecked="{Binding Miestnost}" Style="{StaticResource Volba}" />
                        </WrapPanel>
                        <CheckBox Content="Rámček okolo štítku (na kontrolu alebo strihanie)" IsChecked="{Binding Ramcek}" Margin="0,6,0,0" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kópie každého štítku" Style="{StaticResource Stitok}" />
                                <TextBox Text="{Binding Kopie, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding JeHarok, Converter={StaticResource BoolNaViditelnost}}">
                                <TextBlock Text="Začať od štítku č." Style="{StaticResource Stitok}"
                                           ToolTip="Na čiastočne použitom hárku: štítky sa začnú tlačiť od tejto pozície (počíta sa po riadkoch zľava doprava)." />
                                <TextBox Text="{Binding ZacatOd, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Posun tlače (mm)" Style="{StaticResource Stitok}" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="vodorovne" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding PosunX, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="3" Text="zvisle" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="4" Text="{Binding PosunY, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Popis}" Margin="0,4,0,0"
                                   Text="Ak tlačiareň tlačí mimo štítkov, vytlačte skúšobne jeden hárok na obyčajný papier, priložte ho k hárku štítkov a posuňte tlač (kladné číslo = doprava, dole)." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- náhľad -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{Binding InfoText}" Style="{StaticResource Popis}" FontSize="13" />
                <TextBlock Text="{Binding Upozornenie}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding Upozornenie, Converter={StaticResource NieJePrazdne}}" />
            </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <ItemsControl ItemsSource="{Binding Strany}" Margin="24" HorizontalAlignment="Center">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding MierkaNahladu}" ScaleY="{Binding MierkaNahladu}" />
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,20" Background="White" BorderBrush="#33000000" BorderThickness="1" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <Image Source="{Binding Obrazok}" Width="{Binding Sirka}" Height="{Binding Vyska}" Stretch="Fill" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
