<UserControl x:Class="Evita.Views.CiselnikView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Nadpis}" Style="{StaticResource Nadpis}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Napoveda}" Style="{StaticResource Popis}" Margin="0,-8,0,12" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="Tabulka"
                      ItemsSource="{Binding Polozky}" SelectedItem="{Binding Vybrana}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="StlpecIkony" Header="" Width="34" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Ikona}" ContentTemplate="{StaticResource IkonaKategorie}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Názov" Binding="{Binding Nazov}" Width="2*" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                    <DataGridTextColumn Header="Položiek" Binding="{Binding Pocet}" Width="80" />
                    <DataGridTextColumn Header="Aktívna" Binding="{Binding AktivnaText}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource Karta}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding FormularNadpis}" Style="{StaticResource Podnadpis}" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding Pole1Popis}" Style="{StaticResource Stitok}" />
                    <TextBox Text="{Binding Pole1, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Visibility="{Binding MaPole2, Converter={StaticResource BoolNaViditelnost}}">
                        <TextBlock Text="{Binding Pole2Popis}" Style="{StaticResource Stitok}" />
                        <TextBox Text="{Binding Pole2, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding MaPole3, Converter={StaticResource BoolNaViditelnost}}">
                        <TextBlock Text="{Binding Pole3Popis}" Style="{StaticResource Stitok}" />
                        <TextBox Text="{Binding Pole3, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- ikona a farba kategórie -->
                    <StackPanel Visibility="{Binding SuKategorie, Converter={StaticResource BoolNaViditelnost}}">
                        <DockPanel Margin="0,12,0,4">
                            <ContentPresenter DockPanel.Dock="Left" Content="{Binding NahladIkony}" ContentTemplate="{StaticResource IkonaKategorie}"
                                              Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PopisIkony}" Style="{StaticResource Stitok}" VerticalAlignment="Center" Margin="0" TextWrapping="Wrap" />
                        </DockPanel>
                        <CheckBox Content="Ikona automaticky podľa názvu kategórie" IsChecked="{Binding IkonaAutomaticky}" Margin="0,2,0,6" />
                        <ListBox ItemsSource="{Binding IkonyNaVyber}" SelectedItem="{Binding VybranaIkona}"
                                 IsEnabled="{Binding IkonaAutomaticky, Converter={StaticResource InverzBool}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="170" Padding="0"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="3" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="ToolTip" Value="{Binding Nazov}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IkonaKategorie}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Farba" Style="{StaticResource Stitok}" />
                        <CheckBox Content="Predvolená farba ikony" IsChecked="{Binding FarbaPredvolena}" Margin="0,2,0,6" />
                        <ListBox ItemsSource="{Binding FarbyNaVyber}" SelectedItem="{Binding VybranaFarba}"
                                 IsEnabled="{Binding FarbaPredvolena, Converter={StaticResource InverzBool}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="3" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Converter={StaticResource FarbaNaStetec}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Iná farba (kód #RRGGBB):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding FarbaText, UpdateSourceTrigger=LostFocus}" Width="96" HorizontalAlignment="Left"
                                     ToolTip="Napr. #1E90FF – ľubovoľná farba, napríklad podľa farieb vašej organizácie" />
                        </DockPanel>
                    </StackPanel>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Uložiť" Command="{Binding UlozitCommand}" MinWidth="90" Margin="0,0,6,6"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="{Binding NovaText}" Command="{Binding NovaCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <WrapPanel Visibility="{Binding Upravujem, Converter={StaticResource BoolNaViditelnost}}">
                        <Button Content="Aktivovať / deaktivovať" Command="{Binding PrepnutAktivnuCommand}" Margin="0,0,6,6" />
                        <Button Content="Vymazať" Command="{Binding VymazatCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
