<Window x:Class="Evita.Views.UpozornenieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EviTA – pripomienka"
        Width="360" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Border BorderThickness="5,0,0,0" x:Name="Pruh" Padding="16,12">
        <StackPanel>
            <TextBlock x:Name="Kedy" Style="{StaticResource Popis}" FontSize="12" />
            <TextBlock x:Name="Nazov" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,2" />
            <TextBlock x:Name="Detail" Style="{StaticResource Popis}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Otvoriť kalendár" Padding="10,3" Click="Kalendar_Click" />
                <Button Content="Zavrieť" Padding="10,3" Margin="6,0,0,0" Click="Zavriet_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
