<Window x:Class="Evita.Views.AktualizaciaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nová verzia programu EviTA"
        Width="600" Height="520" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" FontSize="20" />
            <TextBlock x:Name="Podnadpis" Style="{StaticResource Popis}" FontSize="13" Margin="0,0,0,12" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel x:Name="PanelPriebeh" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="Stav" Margin="0,0,0,6" />
                <ProgressBar x:Name="Priebeh" Height="6" Minimum="0" Maximum="100" />
            </StackPanel>
            <TextBlock Style="{StaticResource Popis}" Margin="0,0,0,12"
                       Text="Pred aktualizáciou sa databáza automaticky zálohuje. Windows sa opýta na povolenie inštalácie, potom sa program sám zatvorí, aktualizuje a znova spustí." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Aktualizovat" Content="Aktualizovať teraz" MinWidth="150" Click="Aktualizovat_Click"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="Neskor" Content="Neskôr" MinWidth="110" Margin="8,0,0,0" Click="Neskor_Click" />
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Karta}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Čo je nové" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="Novinky" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
