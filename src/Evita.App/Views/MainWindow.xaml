<Window x:Class="Evita.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Evita.ViewModels"
        xmlns:v="clr-namespace:Evita.Views"
        Title="{Binding TitulokOkna}"
        Width="1320" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EvidenciaViewModel}">
            <v:EvidenciaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CiselnikViewModel}">
            <v:CiselnikView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServisViewModel}">
            <v:ServisView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SviatkyViewModel}">
            <v:SviatkyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CitatyVyrociaViewModel}">
            <v:CitatyVyrociaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <v:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TlacViewModel}">
            <v:TlacView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatistikaViewModel}">
            <v:StatistikaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KalendarViewModel}">
            <v:KalendarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UlohyViewModel}">
            <v:UlohyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PoznamkyViewModel}">
            <v:PoznamkyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NastaveniaViewModel}">
            <v:NastaveniaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkenovanieViewModel}">
            <v:SkenovanieView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ľavé menu -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,16,18">
                    <TextBlock Text="EviTA" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Evidencia IT techniky" Style="{StaticResource Popis}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="20,8,16,16" Style="{StaticResource Popis}"
                           Text="{Binding VerziaText}" />

                <ListBox x:Name="Navigacia" Margin="8,0" BorderThickness="0" Background="Transparent"
                         IsTextSearchEnabled="False" SelectionChanged="Navigacia_SelectionChanged">
                    <ListBoxItem Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE80F;" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="evidencia">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE8FD;" Margin="0,0,12,0" />
                            <TextBlock Text="Evidencia" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="kalendar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE787;" Margin="0,0,12,0" />
                            <TextBlock Text="Kalendár" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ulohy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE73A;" Margin="0,0,12,0" />
                            <TextBlock Text="Úlohy" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="poznamky">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE70B;" Margin="0,0,12,0" />
                            <TextBlock Text="Poznámky" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="statistika">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE9D2;" Margin="0,0,12,0" />
                            <TextBlock Text="Štatistika" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="tlac">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE749;" Margin="0,0,12,0" />
                            <TextBlock Text="Tlač a zostavy" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="skenovanie">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xED14;" Margin="0,0,12,0" />
                            <TextBlock Text="Skenovanie a inventúra" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="import">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE8B5;" Margin="0,0,12,0" />
                            <TextBlock Text="Import a export" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem IsEnabled="False" IsHitTestVisible="False" Focusable="False" Padding="0">
                        <Separator Margin="8,4" />
                    </ListBoxItem>

                    <ListBoxItem Tag="kategorie">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE8EC;" Margin="0,0,12,0" />
                            <TextBlock Text="Kategórie" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="miestnosti">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE707;" Margin="0,0,12,0" />
                            <TextBlock Text="Miestnosti" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="osoby">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE716;" Margin="0,0,12,0" />
                            <TextBlock Text="Osoby" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="sviatky">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE787;" Margin="0,0,12,0" />
                            <TextBlock Text="Sviatky" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="kalendarium">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE8BD;" Margin="0,0,12,0" />
                            <TextBlock Text="Citáty a výročia" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem IsEnabled="False" IsHitTestVisible="False" Focusable="False" Padding="0">
                        <Separator Margin="8,4" />
                    </ListBoxItem>

                    <ListBoxItem Tag="servis">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE90F;" Margin="0,0,12,0" />
                            <TextBlock Text="Servis" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="nastavenia">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE713;" Margin="0,0,12,0" />
                            <TextBlock Text="Nastavenia" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- obsah -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Padding="20,8"
                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding JeNovaVerzia, Converter={StaticResource BoolNaViditelnost}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Aktualizovať…" Padding="12,4"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding AktualizovatCommand}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE896;" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding NovaVerziaText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="0" Padding="20,10"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding UkazkoveData, Converter={StaticResource BoolNaViditelnost}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE946;" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Pracujete s ukážkovými dátami. Keď ich už nepotrebujete, vymažte ich v časti Servis → Vymazať dáta a začať nanovo." />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="2" Margin="24,20,24,16" Content="{Binding AktualnyObsah}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
