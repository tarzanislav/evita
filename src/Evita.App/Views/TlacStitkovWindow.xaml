<Window x:Class="Evita.Views.TlacStitkovWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vytlačiť štítky"
        Width="980" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- tlačidlá -->
        <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{DynamicResource AccentButtonStyle}" Padding="18,6" IsDefault="True" Click="Vytlacit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE749;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Vytlačiť" />
                        </StackPanel>
                    </Button>
                    <Button Content="Zrušiť" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="Suhrn" VerticalAlignment="Center" Style="{StaticResource Popis}" FontSize="13" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- voľby -->
        <ScrollViewer DockPanel.Dock="Left" Width="290" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel Margin="16,12,16,16">
                <TextBlock Text="Tlačiareň" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                <ComboBox x:Name="Tlaciarne" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="FormatText" Style="{StaticResource Popis}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                <TextBlock Text="Strany" Style="{StaticResource Stitok}" />
                <RadioButton x:Name="Vsetky" GroupName="strany" Content="Všetky" IsChecked="True" Click="Rozsah_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="Rozsah" GroupName="strany" Content="Od" VerticalAlignment="Center" MinWidth="0" Click="Rozsah_Changed" />
                    <TextBox x:Name="Od" Width="56" Margin="8,0,0,0" Text="1" TextChanged="Rozsah_Changed" />
                    <TextBlock Text="do" VerticalAlignment="Center" Margin="8,0" />
                    <TextBox x:Name="Do" Width="56" TextChanged="Rozsah_Changed" />
                </StackPanel>
                <TextBlock Style="{StaticResource Popis}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Pred prvou tlačou na štítky vytlačte jeden hárok na obyčajný papier a priložte ho k hárku štítkov – ak nesedí, upravte posun tlače v okne Štítky." />
            </StackPanel>
        </ScrollViewer>

        <!-- náhľad -->
        <DockPanel Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Click="Predosla_Click" Padding="10,4" ToolTip="Predošlá strana">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE76B;" FontSize="12" />
                </Button>
                <TextBlock x:Name="CisloStrany" VerticalAlignment="Center" Margin="14,0" MinWidth="150" TextAlignment="Center" />
                <Button Click="Dalsia_Click" Padding="10,4" ToolTip="Ďalšia strana">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
            <Viewbox Margin="24" Stretch="Uniform" StretchDirection="Both">
                <Border Background="White" BorderBrush="#33000000" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                    </Border.Effect>
                    <Image x:Name="Nahlad" Stretch="Fill" />
                </Border>
            </Viewbox>
        </DockPanel>
    </DockPanel>
</Window>
