<Window x:Class="Evita.Views.UdalostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulok}"
        Width="640" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="24,18,24,20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulok}" Style="{StaticResource Podnadpis}" FontSize="18"
                   TextTrimming="CharacterEllipsis" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Content="Vymazať" MinWidth="100" Command="{Binding VymazatCommand}"
                    Visibility="{Binding JeNova, Converter={StaticResource InverzBoolNaViditelnost}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Uložiť" MinWidth="120" Command="{Binding UlozitCommand}" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" />
                <Button Content="Zrušiť" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <StackPanel>
            <TextBlock Text="Názov" Style="{StaticResource Stitok}" Margin="0,4,0,4" />
            <TextBox x:Name="PoleNazov" Text="{Binding Nazov, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Typ" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Typy}" SelectedValuePath="Id" SelectedValue="{Binding TypId}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}}" />
                                    <TextBlock Text="{Binding Nazov}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Druh" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton GroupName="druh" Content="udalosť" IsChecked="{Binding JeUdalost}" />
                        <RadioButton GroupName="druh" Content="úloha (dá sa odškrtnúť)" IsChecked="{Binding JeUloha}" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <CheckBox Content="Celý deň (alebo obdobie cez viac dní)" IsChecked="{Binding CelyDen}" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Od" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding DatumOd}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Visibility="{Binding UkazCas, Converter={StaticResource BoolNaViditelnost}}">
                    <TextBlock Text="čas" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CasOd, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Do" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding DatumDo}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="6,0,0,0" Visibility="{Binding UkazCas, Converter={StaticResource BoolNaViditelnost}}">
                    <TextBlock Text="čas" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CasDo, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Opakovanie" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Opakovania}" DisplayMemberPath="Nazov" SelectedValuePath="Hodnota"
                              SelectedValue="{Binding Opakovanie}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding Opakuje, Converter={StaticResource BoolNaViditelnost}}">
                    <TextBlock Text="Opakovať do (nepovinné)" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding OpakovanieDo}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Pripomienka" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Pripomienky}" DisplayMemberPath="Nazov" SelectedValuePath="Hodnota"
                              SelectedValue="{Binding Pripomienka}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Naviazanie (nepovinné)" Style="{StaticResource Stitok}" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding PolozkaCislo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Prírastkové číslo položky" />
                <TextBlock Grid.Column="1" Text="{Binding PolozkaText}" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource Popis}" FontSize="13" />
            </Grid>
            <TextBlock Text="prírastkové číslo položky" Style="{StaticResource Popis}" Margin="0,2,0,0" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Miestnosť" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Miestnosti}" DisplayMemberPath="Nazov" SelectedValuePath="Id" SelectedValue="{Binding MiestnostId}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Osoba" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Osoby}" DisplayMemberPath="Nazov" SelectedValuePath="Id" SelectedValue="{Binding OsobaId}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Stav" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Stavy}" DisplayMemberPath="Nazov" SelectedValuePath="Hodnota" SelectedValue="{Binding Stav}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Popis" Style="{StaticResource Stitok}" Margin="0,10,0,4" />
            <TextBox Text="{Binding Popis, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </DockPanel>
</Window>
