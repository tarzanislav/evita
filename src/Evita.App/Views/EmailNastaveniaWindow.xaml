<Window x:Class="Evita.Views.EmailNastaveniaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenie e-mailu"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="Posielanie PDF e-mailom" Style="{StaticResource Podnadpis}" FontSize="18" />

        <RadioButton x:Name="PostovyProgram" GroupName="sposob" Click="Sposob_Click" Margin="0,6,0,0">
            <TextBlock TextWrapping="Wrap" Text="Otvoriť nový e-mail v poštovom programe počítača (Outlook, Thunderbird …) – nič sa nenastavuje" />
        </RadioButton>
        <TextBlock Style="{StaticResource Popis}" FontSize="12" Margin="28,2,0,0" TextWrapping="Wrap"
                   Text="Adresáta doplníte a e-mail odošlete v poštovom programe, zostane vám v Odoslaných. Nový Outlook a pošta v prehliadači prílohu od iných programov neprevezmú – EviTA vtedy ukáže priečinok so súborom." />

        <RadioButton x:Name="Smtp" GroupName="sposob" Click="Sposob_Click" Margin="0,10,0,0">
            <TextBlock TextWrapping="Wrap" Text="Odoslať priamo z EviTA cez server odchádzajúcej pošty (SMTP) – súbor sa neukladá na disk" />
        </RadioButton>

        <Grid x:Name="SekciaSmtp" Margin="28,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Služba" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox x:Name="Sluzba" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="Sluzba_SelectionChanged">
                <ComboBoxItem Tag="ina" Content="Iný server (zadám sám)" />
                <ComboBoxItem Tag="gmail" Content="Gmail (smtp.gmail.com)" />
                <ComboBoxItem Tag="m365" Content="Microsoft 365 / Exchange Online (smtp.office365.com)" />
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Server" VerticalAlignment="Center" Margin="0,0,12,6" />
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                <TextBox x:Name="Port" DockPanel.Dock="Right" Width="70" Margin="8,0,0,0" ToolTip="Port" />
                <TextBlock DockPanel.Dock="Right" Text="Port" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="Server" />
            </DockPanel>

            <TextBlock Grid.Row="2" Text="Zabezpečenie" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox x:Name="Zabezpecenie" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                <ComboBoxItem Tag="SslTls" Content="SSL/TLS (port 465)" />
                <ComboBoxItem Tag="StartTls" Content="STARTTLS (port 587)" />
                <ComboBoxItem Tag="Ziadne" Content="Bez šifrovania (len server v miestnej sieti)" />
            </ComboBox>

            <TextBlock Grid.Row="3" Text="E-mail odosielateľa" VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox x:Name="Odosielatel" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" LostFocus="Odosielatel_LostFocus" />

            <TextBlock Grid.Row="4" Text="Meno odosielateľa" VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox x:Name="MenoOdosielatela" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" />

            <TextBlock Grid.Row="5" Text="Prihlasovacie meno" VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox x:Name="Pouzivatel" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6"
                     ToolTip="Zvyčajne celá e-mailová adresa. Prázdne = server bez prihlasovania." />

            <TextBlock Grid.Row="6" Text="Heslo" VerticalAlignment="Center" Margin="0,0,12,6" />
            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,6">
                <PasswordBox x:Name="Heslo" />
                <TextBlock x:Name="HesloInfo" Style="{StaticResource Popis}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <CheckBox x:Name="KopiaSebe" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,2,0,0">
                <TextBlock TextWrapping="Wrap" Text="Posielať skrytú kópiu aj na adresu odosielateľa (aby ste e-mail mali vo svojej pošte)" />
            </CheckBox>
        </Grid>

        <TextBlock x:Name="Rada" Style="{StaticResource Popis}" FontSize="12" Margin="28,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="Stav" Margin="0,12,0,0" TextWrapping="Wrap" />

        <DockPanel Margin="0,16,0,0">
            <Button x:Name="Skusobny" DockPanel.Dock="Left" Padding="12,5" Click="Skusobny_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Odoslať skúšobný e-mail" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Uložiť" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" Click="Ulozit_Click" IsDefault="True" />
                <Button Content="Zrušiť" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
