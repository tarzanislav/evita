<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809 a novší (kamera cez Windows.Media.Capture) -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EviTA</AssemblyName>
    <RootNamespace>Evita</RootNamespace>
    <ApplicationIcon>Assets\evita.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>EviTA</Product>
    <Company>tarzanislav</Company>
    <Description>EviTA – evidencia informačných technológií a príslušenstva</Description>
    <Copyright>© 2026 tarzanislav</Copyright>
    <SatelliteResourceLanguages>sk;cs;pl;hu;ru;zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.1.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kalendarium.Core\Kalendarium.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\evita.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- licencia sady ikon kategórií (Fluent UI System Icons, MIT) – priložená k programu -->
    <None Include="Assets\LICENSE-fluentui-system-icons.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Native\ZXing.dll')">
    <!-- čítačka kódov zxing-cpp: zostavuje ju GitHub Actions zo zdrojového kódu overenej verzie -->
    <None Include="Native\ZXing.dll" Link="ZXing.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Native\EvitaHlas.dll')">
    <!-- prepis diktovania bez internetu: whisper.cpp (MIT) – zostavuje ju GitHub Actions zo zdrojového kódu overenej verzie -->
    <None Include="Native\EvitaHlas.dll" Link="EvitaHlas.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\LICENSE-whisper.cpp.txt" Link="LICENSE-whisper.cpp.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('Native\LICENSE-whisper.cpp.txt')" />
  </ItemGroup>

  <ItemGroup>
    <!-- preklady textov programu: slovenský text → text v danom jazyku -->
    <EmbeddedResource Include="Preklady\*.json" LogicalName="Evita.Preklady.%(Filename).json" />
  </ItemGroup>

</Project>
