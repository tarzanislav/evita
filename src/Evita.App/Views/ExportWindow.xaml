<Window x:Class="Evita.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export evidencie"
        Width="860" Height="660" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Export evidencie" Style="{StaticResource Podnadpis}" FontSize="20" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <CheckBox Content="Po exporte súbor otvoriť" IsChecked="{Binding OtvoritPoExporte}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <Button Content="Exportovať…" MinWidth="130" Command="{Binding ExportovatCommand}"
                    Style="{DynamicResource AccentButtonStyle}" IsDefault="True" />
            <Button Content="Zrušiť" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Čo exportovať" Style="{StaticResource Stitok}" Margin="0,0,0,6" />
                    <RadioButton GroupName="rozsah" Content="{Binding TextCela}" IsChecked="{Binding RozsahCela}" />
                    <RadioButton GroupName="rozsah" Content="{Binding TextVyfiltrovane}" IsChecked="{Binding RozsahVyfiltrovane}"
                                 IsEnabled="{Binding MaVyfiltrovane}" />
                    <RadioButton GroupName="rozsah" Content="{Binding TextOznacene}" IsChecked="{Binding RozsahOznacene}"
                                 IsEnabled="{Binding MaOznacene}" />
                    <TextBlock Style="{StaticResource Popis}" Margin="0,2,0,0"
                               Text="Vyfiltrované a označené položky sa dajú exportovať z obrazovky Evidencia tlačidlom Export." />

                    <TextBlock Text="Formát" Style="{StaticResource Stitok}" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding Formaty}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="format" IsChecked="{Binding Vybrany}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Popis}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Content="Pridať hárok pre každú kategóriu" IsChecked="{Binding HarokPreKategoriu}" Margin="0,8,0,0"
                              Visibility="{Binding UkazHarky, Converter={StaticResource BoolNaViditelnost}}" />
                    <CheckBox Content="Vrátane histórie zmien" IsChecked="{Binding SHistoriou}" Margin="0,8,0,0"
                              Visibility="{Binding UkazHistoriu, Converter={StaticResource BoolNaViditelnost}}" />
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Stĺpce" Style="{StaticResource Stitok}" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding PoznamkaFormatu}" Style="{StaticResource Popis}"
                           Visibility="{Binding UkazHistoriu, Converter={StaticResource BoolNaViditelnost}}" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding UkazStlpce, Converter={StaticResource BoolNaViditelnost}}">
                    <Button Content="Všetky" Padding="10,4" Command="{Binding VsetkyStlpceCommand}" />
                    <Button Content="Predvolené" Padding="10,4" Margin="8,0,0,0" Command="{Binding PredvoleneStlpceCommand}" />
                </StackPanel>
                <Border Style="{StaticResource Karta}" Padding="10,6"
                        Visibility="{Binding UkazStlpce, Converter={StaticResource BoolNaViditelnost}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Stlpce}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Nazov}" IsChecked="{Binding Vybrany}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
