<Window x:Class="Evita.Views.PrveSpustenieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitajte v programe EviTA"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="28">
        <TextBlock Text="Vitajte v programe EviTA" Style="{StaticResource Nadpis}" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Program je pripravený. Môžete začať s ukážkovou evidenciou a vyskúšať si všetky funkcie, alebo rovno začať vlastnú evidenciu." />

        <TextBlock Text="Názov organizácie (nepovinné, zobrazí sa v hlavičke tlačových zostáv)" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
        <TextBox x:Name="Organizacia" Margin="0,0,0,20" />

        <Button Click="Ukazkove_Click" HorizontalContentAlignment="Left" Padding="16,12"
                Style="{DynamicResource AccentButtonStyle}">
            <StackPanel>
                <TextBlock Text="Začať s ukážkovými dátami" FontWeight="SemiBold" FontSize="15" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="200 položiek, 30 osôb, 25 miestností a história zmien. Neskôr ich jedným tlačidlom vymažete v časti Servis." />
            </StackPanel>
        </Button>

        <Button Click="Prazdna_Click" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Začať s prázdnou databázou" FontWeight="SemiBold" FontSize="15" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Evidencia začne od prírastkového čísla 1. Kategórie sú už pripravené." />
            </StackPanel>
        </Button>

        <Button Click="Import_Click" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Naimportovať existujúcu evidenciu" FontWeight="SemiBold" FontSize="15" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Zo starej evidencie v Exceli alebo CSV, alebo z exportu EviTA z iného počítača. Otvorí sa sprievodca importom." />
            </StackPanel>
        </Button>

        <TextBlock Style="{StaticResource Popis}" Margin="0,20,0,0"
                   Text="Zálohu EviTA (súbor ZIP) obnovíte po otvorení programu v časti Servis → Obnova." />
    </StackPanel>
</Window>
