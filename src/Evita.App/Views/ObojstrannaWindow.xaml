<Window x:Class="Evita.Views.ObojstrannaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenie obojstrannej tlače"
        Width="640" SizeToContent="Height" MinHeight="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22,18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Hlavne" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Click="Hlavne_Click" />
            <Button x:Name="Zavriet" Content="Zavrieť" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" FontSize="18" TextWrapping="Wrap" />
            <TextBlock x:Name="Tlaciaren" Style="{StaticResource Popis}" Margin="0,0,0,12" TextWrapping="Wrap" />
            <TextBlock x:Name="Text" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
            <StackPanel x:Name="Moznosti" Margin="0,12,0,0" />
            <TextBlock x:Name="Moznosti2Nadpis" TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0" Visibility="Collapsed" />
            <StackPanel x:Name="Moznosti2" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
