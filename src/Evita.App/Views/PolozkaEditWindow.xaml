<Window x:Class="Evita.Views.PolozkaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulok}"
        Width="860" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Pole" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="TlacidloPlus" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Padding="12,5" Command="{Binding StitokCommand}"
                    Visibility="{Binding JeNova, Converter={StaticResource InverzBoolNaViditelnost}}"
                    ToolTip="Vytlačiť štítok s QR kódom pre túto položku">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xED14;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Štítok…" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Uložiť" MinWidth="120" IsDefault="False" Command="{Binding UlozitCommand}"
                        Style="{DynamicResource AccentButtonStyle}" ToolTip="Ctrl+S" />
                <Button Content="Zrušiť" MinWidth="120" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulok}" Style="{StaticResource Podnadpis}" FontSize="20"
                   TextTrimming="CharacterEllipsis" />

        <TabControl>
            <TabItem Header="Údaje">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ľavý stĺpec -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prírastkové číslo" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PrirastkoveCisloText, Mode=OneWay}" IsReadOnly="True" Focusable="False" />

                            <TextBlock Text="Názov technológie *" Style="{StaticResource Stitok}" />
                            <TextBox x:Name="NazovPole" Text="{Binding Nazov, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Kategória *" Style="{StaticResource Stitok}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource TlacidloPlus}"
                                        ToolTip="Vytvoriť novú kategóriu" Command="{Binding NovaKategoriaCommand}" />
                                <ComboBox ItemsSource="{Binding Kategorie}" DisplayMemberPath="Nazov" SelectedValuePath="Id"
                                          SelectedValue="{Binding KategoriaId}" />
                            </DockPanel>

                            <TextBlock Text="Miestnosť" Style="{StaticResource Stitok}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource TlacidloPlus}"
                                        ToolTip="Vytvoriť novú miestnosť" Command="{Binding NovaMiestnostCommand}" />
                                <ComboBox ItemsSource="{Binding Miestnosti}" DisplayMemberPath="Nazov" SelectedValuePath="Id"
                                          SelectedValue="{Binding MiestnostId}" />
                            </DockPanel>

                            <TextBlock Text="Pridelené" Style="{StaticResource Stitok}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource TlacidloPlus}"
                                        ToolTip="Pridať novú osobu" Command="{Binding NovaOsobaCommand}" />
                                <ComboBox ItemsSource="{Binding Osoby}" DisplayMemberPath="Nazov" SelectedValuePath="Id"
                                          SelectedValue="{Binding OsobaId}" />
                            </DockPanel>

                            <TextBlock Text="Stav" Style="{StaticResource Stitok}" />
                            <ComboBox ItemsSource="{Binding Stavy}" DisplayMemberPath="Nazov" SelectedValuePath="Stav"
                                      SelectedValue="{Binding Stav}" />

                            <StackPanel Visibility="{Binding JeVyradena, Converter={StaticResource BoolNaViditelnost}}">
                                <TextBlock Text="Dátum vyradenia" Style="{StaticResource Stitok}" />
                                <DatePicker SelectedDate="{Binding DatumVyradenia}" />
                                <TextBlock Text="Dôvod vyradenia" Style="{StaticResource Stitok}" />
                                <TextBox Text="{Binding DovodVyradenia, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding JeNova, Converter={StaticResource BoolNaViditelnost}}">
                                <TextBlock Text="Počet kusov (hromadné pridanie)" Style="{StaticResource Stitok}" />
                                <TextBox Text="{Binding PocetKusov, UpdateSourceTrigger=PropertyChanged}" Width="100"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="Sériové čísla jednotlivých kusov (každé na nový riadok, nepovinné)"
                                           Style="{StaticResource Stitok}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding SerioveCislaHromadne, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="90"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                            </StackPanel>
                        </StackPanel>

                        <!-- pravý stĺpec -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Výrobca" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Vyrobca, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Model" Style="{StaticResource Stitok}" />
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Sériové číslo" Style="{StaticResource Stitok}" />
                            <TextBox Text="{Binding SerioveCislo, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Inventárne číslo" Style="{StaticResource Stitok}" />
                            <TextBox Text="{Binding InventarneCislo, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="EAN (čiarový kód výrobku z krabice)" Style="{StaticResource Stitok}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Command="{Binding DoplnitPodlaEanCommand}"
                                        ToolTip="Vyhľadať výrobcu, model a názov podľa EAN vo vlastnej evidencii a na internete">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE721;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Doplniť z internetu" />
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding Ean, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="Hľadám údaje o výrobku…" Style="{StaticResource Popis}" Margin="0,4,0,0"
                                       Visibility="{Binding HladamEan, Converter={StaticResource BoolNaViditelnost}}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Dátum nákupu" Style="{StaticResource Stitok}" />
                                    <DatePicker SelectedDate="{Binding DatumNakupu}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cena (€)" Style="{StaticResource Stitok}" />
                                    <TextBox Text="{Binding CenaText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Záruka do" Style="{StaticResource Stitok}" />
                                    <DatePicker SelectedDate="{Binding ZarukaDo}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ďalšia revízia" Style="{StaticResource Stitok}" />
                                    <DatePicker SelectedDate="{Binding DalsiaRevizia}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Poznámka" Style="{StaticResource Stitok}" />
                            <TextBox Text="{Binding Poznamka, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                            <StackPanel Visibility="{Binding JeNova, Converter={StaticResource InverzBoolNaViditelnost}}"
                                        Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Popis}">
                                    <Run Text="Pridané:" /> <Run Text="{Binding DatumPridaniaText, Mode=OneWay}" />
                                    <Run Text="   Naposledy zmenené:" /> <Run Text="{Binding DatumZmenyText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="História zmien"
                     Visibility="{Binding JeNova, Converter={StaticResource InverzBoolNaViditelnost}}">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Popis}" Margin="0,0,0,8"
                               Text="Každá zmena položky s dátumom, časom a používateľom. Najnovšie hore." />
                    <DataGrid ItemsSource="{Binding Historia}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dátum a čas" Binding="{Binding Cas, StringFormat='d. M. yyyy H:mm'}" Width="130" />
                            <DataGridTextColumn Header="Akcia" Binding="{Binding Akcia, Converter={StaticResource PrelozText}}" Width="95" />
                            <DataGridTextColumn Header="Pole" Binding="{Binding Pole, Converter={StaticResource PrelozText}}" Width="120" />
                            <DataGridTextColumn Header="Pôvodne" Binding="{Binding StaraHodnota}" Width="*" />
                            <DataGridTextColumn Header="Nová hodnota" Binding="{Binding NovaHodnota}" Width="*" />
                            <DataGridTextColumn Header="Používateľ" Binding="{Binding Pouzivatel}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Udalosti"
                     Visibility="{Binding JeNova, Converter={StaticResource InverzBoolNaViditelnost}}">
                <DockPanel Margin="0,8,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Nová udalosť k položke…" Padding="12,4" Command="{Binding NovaUdalostCommand}" />
                        <TextBlock Style="{StaticResource Popis}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Servis, revízie a ďalšie udalosti kalendára naviazané na túto položku (rok dozadu a dva roky dopredu), aj koniec záruky a ďalšia revízia. Dvojklikom otvoríte udalosť." />
                    </DockPanel>
                    <DataGrid x:Name="TabulkaUdalosti" ItemsSource="{Binding Udalosti}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" SelectionMode="Single"
                              MouseDoubleClick="TabulkaUdalosti_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="12">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="6" Margin="0,2" CornerRadius="2"
                                                Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dátum" Binding="{Binding Zaciatok, Mode=OneWay, StringFormat='d. M. yyyy'}" Width="95" />
                            <DataGridTextColumn Header="Čas" Binding="{Binding CasText, Mode=OneWay}" Width="110" />
                            <DataGridTextColumn Header="Udalosť" Binding="{Binding Nazov, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding Typ, Mode=OneWay}" Width="110" />
                            <DataGridTextColumn Header="Stav" Binding="{Binding StavText, Mode=OneWay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Poznámky a úlohy"
                     Visibility="{Binding JeNova, Converter={StaticResource InverzBoolNaViditelnost}}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Nová poznámka…" Padding="12,4" Command="{Binding NovaPoznamkaCommand}" />
                            <TextBlock Text="Poznámky k položke" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="K položke zatiaľ nie sú poznámky." Style="{StaticResource Popis}"
                                       Visibility="{Binding Poznamky.Count, Converter={StaticResource NulaNaViditelnost}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Poznamky}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Cursor="Hand" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.OtvorPoznamkuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Border CornerRadius="5" Padding="10,6" Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" Foreground="#1B1B1B" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Nahlad}" Foreground="#3A3A3A" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ZmeneneText}" Foreground="#5A5A5A" FontSize="11" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Úlohy k položke" FontWeight="SemiBold" Margin="0,4,0,8" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox Text="{Binding NovaUloha, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding PridatUlohuCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Nová úloha – napíšte a stlačte Enter" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding NovaUloha, Converter={StaticResource NieJePrazdne}, ConverterParameter=opacne}" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="K položke zatiaľ nie sú úlohy." Style="{StaticResource Popis}"
                                   Visibility="{Binding UlohyPolozky.Count, Converter={StaticResource NulaNaViditelnost}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UlohyPolozky}" ItemTemplate="{StaticResource UlohaRiadok}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
