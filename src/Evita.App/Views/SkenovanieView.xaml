<UserControl x:Class="Evita.Views.SkenovanieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pom="clr-namespace:Evita.Pomocne">
    <UserControl.Resources>
        <Style x:Key="MaleTlacidlo" TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Skenovanie" Style="{StaticResource Nadpis}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- skenovanie -->
                    <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xED14;" Margin="0,0,10,0" />
                                <TextBlock Text="Naskenujte kód" Style="{StaticResource Podnadpis}" Margin="0" />
                            </StackPanel>
                            <Grid>
                                <TextBox x:Name="Pole" FontSize="18" Padding="10,8" pom:CitackaKodov.SkenovaciePole="True"
                                         ToolTip="Štítok EviTA, inventárne alebo sériové číslo, prírastkové číslo alebo EAN výrobku" />
                                <TextBlock Text="Naskenujte alebo napíšte kód a stlačte Enter" Margin="14,0,0,0" FontSize="14"
                                           VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding Text, ElementName=Pole, Converter={StaticResource NieJePrazdne}, ConverterParameter=opacne}" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Padding="14,6" Margin="0,0,8,0" Command="{Binding KameraCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE722;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Kamera počítača…" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="14,6" Command="{Binding MobilCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE8EA;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Mobil ako skener…" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Popis}" Margin="0,10,0,0"
                                       Text="Čítačka čiarových a QR kódov (USB alebo Bluetooth) funguje v celom programe – naskenovaná položka sa otvorí, kdekoľvek práve ste. Rozpozná štítok EviTA, inventárne, sériové aj prírastkové číslo a EAN výrobku. Ak čítačka namiesto číslic píše znaky ako ľščť, EviTA ich opraví sama." />
                        </StackPanel>
                    </Border>

                    <!-- posledné skeny -->
                    <Border Style="{StaticResource Karta}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Vymazať zoznam" Padding="10,3" Command="{Binding VymazatZoznamCommand}"
                                        Visibility="{Binding MaPosledne, Converter={StaticResource BoolNaViditelnost}}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE81C;" Margin="0,0,10,0" />
                                    <TextBlock Text="Posledné skeny" Style="{StaticResource Podnadpis}" Margin="0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="Zatiaľ ste nič nenaskenovali." Style="{StaticResource Popis}"
                                       Visibility="{Binding MaPosledne, Converter={StaticResource InverzBoolNaViditelnost}}" />
                            <ItemsControl ItemsSource="{Binding Posledne}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <DockPanel>
                                                <TextBlock x:Name="Znak" DockPanel.Dock="Left" Style="{StaticResource Ikona}" Text="&#xE73E;" FontSize="18"
                                                           Margin="0,0,12,0" VerticalAlignment="Top"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Otvoriť" Style="{StaticResource MaleTlacidlo}"
                                                            Visibility="{Binding JednaPolozka, Converter={StaticResource BoolNaViditelnost}}"
                                                            Command="{Binding DataContext.OtvoritRiadokCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="V evidencii" Style="{StaticResource MaleTlacidlo}"
                                                            Visibility="{Binding Najdene, Converter={StaticResource BoolNaViditelnost}}"
                                                            Command="{Binding DataContext.ZobrazitVEvidenciiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Nová položka…" Style="{StaticResource MaleTlacidlo}"
                                                            Visibility="{Binding Nenajdene, Converter={StaticResource BoolNaViditelnost}}"
                                                            ToolTip="Pridať novú položku s týmto kódom (EAN výrobku doplní údaje z internetu, iný kód sa zapíše ako sériové číslo)"
                                                            Command="{Binding DataContext.NovaPolozkaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding Detail, Converter={StaticResource NieJePrazdne}}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="{Binding Cas, Mode=OneWay}" /> · <Run Text="{Binding Zdroj, Mode=OneWay}" /> · <Run Text="{Binding Kod, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Najdene}" Value="False">
                                                <Setter TargetName="Znak" Property="Text" Value="&#xE9CE;" />
                                                <Setter TargetName="Znak" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- inventúra -->
                    <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE9D5;" Margin="0,0,10,0" />
                                <TextBlock Text="Inventúra" Style="{StaticResource Podnadpis}" Margin="0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Popis}" Margin="0,0,0,10"
                                       Text="Prejdite miestnosti a naskenujte štítky položiek. EviTA ukáže, čo chýba a čo je v inej miestnosti, než má v evidencii, a vytvorí inventúrny protokol s podpismi." />
                            <TextBlock Text="Zatiaľ ste nerobili žiadnu inventúru." Style="{StaticResource Popis}"
                                       Visibility="{Binding Inventury.Count, Converter={StaticResource NulaNaViditelnost}}" />
                            <ListBox ItemsSource="{Binding Inventury}" SelectedItem="{Binding VybranaInventura}" MaxHeight="260"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding Inventury.Count, Converter={StaticResource NulaNaViditelnost}, ConverterParameter=opacne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StavText}" FontSize="12" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding ObdobieText, Mode=OneWay}" /> · <Run Text="{Binding PostupText, Mode=OneWay}" />
                                            </TextBlock>
                                            <ProgressBar Value="{Binding Percento, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,8" Command="{Binding NovaInventuraCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Nová inventúra…" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Pokračovať…" Padding="14,6" Margin="0,0,8,8" Command="{Binding PokracovatInventuruCommand}"
                                        Visibility="{Binding Inventury.Count, Converter={StaticResource NulaNaViditelnost}, ConverterParameter=opacne}" />
                                <Button Content="Protokol…" Padding="14,6" Margin="0,0,8,8" Command="{Binding ProtokolInventuryCommand}"
                                        Visibility="{Binding Inventury.Count, Converter={StaticResource NulaNaViditelnost}, ConverterParameter=opacne}" />
                                <Button Content="Vymazať" Padding="14,6" Margin="0,0,8,8" Command="{Binding VymazatInventuruCommand}"
                                        Visibility="{Binding Inventury.Count, Converter={StaticResource NulaNaViditelnost}, ConverterParameter=opacne}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- štítky -->
                    <Border Style="{StaticResource Karta}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE8EC;" Margin="0,0,10,0" />
                                <TextBlock Text="Štítky s QR kódom" Style="{StaticResource Podnadpis}" Margin="0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Popis}" Margin="0,0,0,4"
                                       Text="Štítky na samolepiace hárky A4 alebo na tlačiareň štítkov. Pre vybrané položky ich vytlačíte aj z Evidencie (tlačidlo Štítky) a z karty položky." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Miestnosť" Style="{StaticResource Stitok}" />
                                    <ComboBox ItemsSource="{Binding MiestnostiStitkov}" DisplayMemberPath="Nazov" SelectedValuePath="Id"
                                              SelectedValue="{Binding MiestnostStitkov}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Kategória" Style="{StaticResource Stitok}" />
                                    <ComboBox ItemsSource="{Binding KategorieStitkov}" DisplayMemberPath="Nazov" SelectedValuePath="Id"
                                              SelectedValue="{Binding KategoriaStitkov}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Aj vyradené položky" IsChecked="{Binding AjVyradene}" Margin="0,8,0,0" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Left" Padding="14,6" Command="{Binding TlacitStitkyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE749;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Štítky…" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding PocetStitkovText}" Style="{StaticResource Popis}" FontSize="13" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- nastavenia -->
                    <Border Style="{StaticResource Karta}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE713;" Margin="0,0,10,0" />
                                <TextBlock Text="Nastavenia skenovania" Style="{StaticResource Podnadpis}" Margin="0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding Zvuk}">
                                <TextBlock Text="Zvuk po naskenovaní" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding OtvoritKartu}">
                                <TextBlock Text="Po naskenovaní otvoriť kartu položky" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CitackaVsade}"
                                      ToolTip="Ak je vypnuté, kódy z čítačky sa spracujú len v poli Naskenujte kód a v okne inventúry.">
                                <TextBlock Text="Rozpoznať čítačku kódov v celom programe" TextWrapping="Wrap" />
                            </CheckBox>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Port pre mobil" Style="{StaticResource Stitok}" />
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Používateľ Icecat (nepovinné)" Style="{StaticResource Stitok}" />
                                    <TextBox Text="{Binding Icecat, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Popis}" Margin="0,8,0,0"
                                       Text="Údaje o výrobku podľa EAN sa hľadajú vo vlastnej evidencii, v katalógu Open Icecat a v databáze UPCitemdb (bez registrácie; UPCitemdb najviac 100 vyhľadaní denne). S vlastným účtom Icecat nájdete viac výrobkov." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
