<Window x:Class="Evita.Views.TlacWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vytlačiť"
        Width="1100" Height="780" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- tlačidlá -->
        <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="Vytlacit" Style="{DynamicResource AccentButtonStyle}" Padding="18,6" IsDefault="True" Click="Vytlacit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Ikona}" Text="&#xE749;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Vytlačiť" />
                        </StackPanel>
                    </Button>
                    <Button Content="Zrušiť" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="Suhrn" VerticalAlignment="Center" Style="{StaticResource Popis}" FontSize="13" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- voľby -->
        <ScrollViewer DockPanel.Dock="Left" Width="290" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel Margin="16,12,16,16">
                <TextBlock Text="Tlačiareň" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                <ComboBox x:Name="Tlaciarne" HorizontalAlignment="Stretch" SelectionChanged="Volba_Changed" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Kópie" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="Kopie" Width="64" Text="1" TextChanged="Volba_Changed" HorizontalAlignment="Left" />
                </DockPanel>
                <CheckBox x:Name="Obojstranne" Content="Obojstranne" Margin="0,8,0,0" Click="Volba_Changed" />

                <TextBlock Text="Strany na list" Style="{StaticResource Stitok}" />
                <RadioButton x:Name="Jedna" GroupName="rozmiestnenie" Content="1 strana" Click="Volba_Changed" />
                <RadioButton x:Name="Dve" GroupName="rozmiestnenie" Content="2 strany" Click="Volba_Changed" />
                <RadioButton x:Name="Styri" GroupName="rozmiestnenie" Content="4 strany" Click="Volba_Changed" />
                <RadioButton x:Name="Osem" GroupName="rozmiestnenie" Content="8 strán" Click="Volba_Changed" />
                <RadioButton x:Name="Brozura" GroupName="rozmiestnenie" Content="Brožúra (preložiť v strede)" Click="Volba_Changed"
                             ToolTip="Strany sa usporiadajú tak, aby po obojstrannej tlači a preložení listov v strede vznikol zošit A5." />
                <CheckBox x:Name="Opakovat" Content="Opakovať stránky" Margin="0,6,0,0" Click="Volba_Changed"
                          ToolTip="Každá strana sa na liste zopakuje (2, 4 alebo 8 rovnakých strán vedľa seba) – napr. na rozstrihanie." />

                <TextBlock Text="Zväčšenie zmenšených strán" Style="{StaticResource Stitok}" />
                <DockPanel>
                    <TextBlock x:Name="ZvacsenieText" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" Text="100 %" />
                    <Slider x:Name="Zvacsenie" Minimum="100" Maximum="160" TickFrequency="5" IsSnapToTickEnabled="True" Value="100"
                            ValueChanged="Zvacsenie_ValueChanged"
                            ToolTip="Zmenšené strany majú prázdne okraje – zväčšením sa orežú a text bude väčší (napr. 2 strany na A4 skoro ako A5)." />
                </DockPanel>

                <TextBlock Text="Úprava" Style="{StaticResource Stitok}" />
                <CheckBox x:Name="Ramcek" Content="Orámovanie strán (tenký rám)" Click="Volba_Changed" />
                <CheckBox x:Name="Siva" Content="Odtiene sivej" Margin="0,6,0,0" Click="Volba_Changed" />
                <CheckBox x:Name="Dierovac" Content="Dierovač – okraj zľava" Margin="0,6,0,0" Click="Volba_Changed"
                          ToolTip="Vľavo sa vynechá miesto na dierovanie, aby sa list dal založiť do zakladača (pri obojstrannej tlači na zadnej strane sprava)." />
                <DockPanel Margin="26,4,0,0">
                    <TextBlock Text="mm" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBox x:Name="DierovacMm" Width="64" Text="10" HorizontalAlignment="Left" TextChanged="Volba_Changed" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- náhľad listu -->
        <DockPanel Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="Predosly" Padding="10,4" Click="Predosly_Click" ToolTip="Predošlá strana listu">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE76B;" FontSize="12" />
                </Button>
                <TextBlock x:Name="CisloListu" VerticalAlignment="Center" Margin="14,0" MinWidth="150" TextAlignment="Center" />
                <Button x:Name="Dalsi" Padding="10,4" Click="Dalsi_Click" ToolTip="Ďalšia strana listu">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
            <Viewbox Margin="24,12,24,24" Stretch="Uniform">
                <Border Background="White" BorderBrush="#55000000" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3" />
                    </Border.Effect>
                    <Image x:Name="Nahlad" Stretch="Fill" />
                </Border>
            </Viewbox>
        </DockPanel>
    </DockPanel>
</Window>
