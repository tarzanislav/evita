<UserControl x:Class="Evita.Views.PoznamkaEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBox x:Name="PoleNazov" DockPanel.Dock="Top" Text="{Binding Nazov, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="18" FontWeight="SemiBold" ToolTip="Názov poznámky (ak ho nevyplníte, použije sa prvý riadok textu)" />

        <!-- farba a pripnutie -->
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Pripnuta}" VerticalAlignment="Center"
                      ToolTip="Pripnuté poznámky sú v zozname hore a zobrazujú sa na dashboarde">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Ikona}" Text="&#xE718;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock Text="Pripnúť" />
                </StackPanel>
            </CheckBox>
            <TextBlock Text="Farba" Style="{StaticResource Stitok}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Farby}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="22" Height="22" Margin="0,2,5,2" Padding="0" Cursor="Hand"
                                Command="{Binding DataContext.ZvolFarbuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="11" Background="{Binding Converter={StaticResource FarbaNaStetec}}"
                                            BorderThickness="1" BorderBrush="#40000000" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- diktovanie hlasom -->
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <Button x:Name="Diktovat" Padding="10,4" Click="Diktovat_Click"
                    ToolTip="Diktovať poznámku do mikrofónu – text sa zapíše na miesto kurzora (slovenčina)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IkonaDiktovania" Style="{StaticResource Ikona}" Text="&#xE720;" FontSize="13" Margin="0,0,6,0" />
                    <TextBlock x:Name="TextDiktovania" Text="Diktovať" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Padding="8,4" Click="NastavenieDiktovania_Click" ToolTip="Nastavenie diktovania">
                <TextBlock Style="{StaticResource Ikona}" Text="&#xE713;" FontSize="12" />
            </Button>
            <Rectangle x:Name="Hlasitost" Width="0" Height="6" RadiusX="3" RadiusY="3" Margin="10,0,0,0" VerticalAlignment="Center"
                       Fill="{DynamicResource SystemFillColorSuccessBrush}" />
            <TextBlock x:Name="StavDiktovania" Style="{StaticResource Popis}" FontSize="12" Margin="10,0,8,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>

        <!-- prepojenia -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Karta}" Padding="12,8,12,10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Prepojenie (nepovinné)" FontWeight="SemiBold" />
                <TextBlock Text="Deň v kalendári" Style="{StaticResource Stitok}" Margin="0,8,0,3" />
                <WrapPanel>
                    <DatePicker SelectedDate="{Binding Datum}" Width="150" Margin="0,0,6,0" />
                    <Button Content="Dnes" Padding="10,4" Margin="0,0,6,0" Command="{Binding DnesCommand}" />
                    <Button Padding="8,4" Command="{Binding ZrusitDatumCommand}" ToolTip="Zrušiť prepojenie s dňom"
                            Visibility="{Binding MaDatum, Converter={StaticResource BoolNaViditelnost}}">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE711;" FontSize="11" />
                    </Button>
                </WrapPanel>

                <TextBlock Text="Položka (prírastkové číslo)" Style="{StaticResource Stitok}" Margin="0,8,0,3" />
                <DockPanel>
                    <TextBox Width="80" Text="{Binding PolozkaCislo, UpdateSourceTrigger=PropertyChanged}" />
                    <Button DockPanel.Dock="Right" Content="Otvoriť…" Padding="10,4" Margin="6,0,0,0" Command="{Binding OtvorPolozkuCommand}"
                            Visibility="{Binding MaPolozku, Converter={StaticResource BoolNaViditelnost}}" />
                    <TextBlock Text="{Binding PolozkaText}" Style="{StaticResource Popis}" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding PolozkaText}" />
                </DockPanel>

                <TextBlock Text="Udalosť v kalendári" Style="{StaticResource Stitok}" Margin="0,8,0,3" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Otvoriť…" Padding="10,4" Margin="6,0,0,0" Command="{Binding OtvorUdalostCommand}"
                            Visibility="{Binding MaUdalost, Converter={StaticResource BoolNaViditelnost}}" />
                    <ComboBox ItemsSource="{Binding Udalosti}" DisplayMemberPath="Nazov" SelectedValuePath="Id"
                              SelectedValue="{Binding UdalostId}" IsTextSearchEnabled="True" TextSearch.TextPath="Nazov" />
                </DockPanel>
                <TextBlock Style="{StaticResource Popis}" Margin="0,8,0,0"
                           Visibility="{Binding JeNova, Converter={StaticResource InverzBoolNaViditelnost}}">
                    <Run Text="Vytvorená:" /> <Run Text="{Binding Vytvorene, Mode=OneWay}" />
                    <Run Text="   Zmenená:" /> <Run Text="{Binding ZmeneneText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- text poznámky ako lístok vo zvolenej farbe -->
        <Border Margin="0,10,0,0" CornerRadius="6" Padding="2" Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}}">
            <TextBox x:Name="PoleText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="160" VerticalContentAlignment="Top"
                     Background="Transparent" BorderThickness="0" Foreground="#1B1B1B" CaretBrush="#1B1B1B"
                     FontSize="14" Padding="8,6" />
        </Border>
    </DockPanel>
</UserControl>
