<Window x:Class="Evita.Views.EmailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poslať e-mailom"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="Poslať e-mailom" Style="{StaticResource Podnadpis}" FontSize="18" />
        <TextBlock x:Name="Odkial" Style="{StaticResource Popis}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

        <TextBlock Text="Komu" Style="{StaticResource Stitok}" Margin="0,0,0,2" />
        <TextBox x:Name="Komu" ToolTip="Viac adries oddeľte čiarkou alebo bodkočiarkou." />
        <TextBlock Text="Predmet" Style="{StaticResource Stitok}" Margin="0,8,0,2" />
        <TextBox x:Name="Predmet" />
        <TextBlock Text="Text" Style="{StaticResource Stitok}" Margin="0,8,0,2" />
        <TextBox x:Name="Text" AcceptsReturn="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" />

        <TextBlock Text="Prílohy" Style="{StaticResource Stitok}" Margin="0,8,0,2" />
        <ItemsControl x:Name="Prilohy">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE723;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox x:Name="KopiaSebe" Content="Skrytá kópia aj mne" Margin="0,10,0,0" />

        <TextBlock x:Name="Stav" Margin="0,10,0,0" TextWrapping="Wrap" />

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="Nastavenie e-mailu…" Padding="12,5" Click="Nastavenie_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Odoslat" MinWidth="120" Style="{DynamicResource AccentButtonStyle}" Click="Odoslat_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Odoslať" />
                    </StackPanel>
                </Button>
                <Button Content="Zrušiť" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
