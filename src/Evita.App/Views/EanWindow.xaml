<Window x:Class="Evita.Views.EanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Údaje o výrobku podľa EAN"
        Width="720" Height="740" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Prevziať vybrané údaje" MinWidth="160" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Prevziat_Click" />
            <Button Content="Zrušiť" MinWidth="110" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" FontSize="18" />
            <TextBlock Text="Vyberte zdroj a údaje, ktoré chcete prevziať do karty položky. Pred prevzatím ich môžete upraviť." Style="{StaticResource Popis}" FontSize="13" />
        </StackPanel>

        <TextBlock x:Name="Spravy" DockPanel.Dock="Bottom" Style="{StaticResource Popis}" Margin="0,10,0,0" />

        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="190" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ListBox x:Name="Zdroje" SelectionChanged="Zdroje_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Prehlad}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Zdroj}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox x:Name="PrevziatNazov" Content="Názov" IsChecked="True" />
                    <TextBox x:Name="Nazov" Margin="28,0,0,6" />
                    <CheckBox x:Name="PrevziatVyrobca" Content="Výrobca" IsChecked="True" />
                    <TextBox x:Name="Vyrobca" Margin="28,0,0,6" />
                    <CheckBox x:Name="PrevziatModel" Content="Model" IsChecked="True" />
                    <TextBox x:Name="Model" Margin="28,0,0,6" />
                    <CheckBox x:Name="PrevziatKategoriu" Content="Kategória" IsChecked="True" />
                    <TextBlock x:Name="Kategoria" Margin="28,0,0,6" TextWrapping="Wrap" />
                    <TextBlock x:Name="Popis" Style="{StaticResource Popis}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
