<Application x:Class="Evita.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pom="clr-namespace:Evita.Pomocne"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolNaViditelnost" />
            <pom:InverzBoolNaViditelnost x:Key="InverzBoolNaViditelnost" />
            <pom:InverzBool x:Key="InverzBool" />
            <pom:NieJePrazdne x:Key="NieJePrazdne" />
            <pom:NulaNaViditelnost x:Key="NulaNaViditelnost" />
            <pom:FarbaNaStetec x:Key="FarbaNaStetec" />
            <pom:HodnotyNaKrivku x:Key="HodnotyNaKrivku" />
            <pom:PrelozText x:Key="PrelozText" />
            <pom:RovnaSa x:Key="RovnaSa" />

            <FontFamily x:Key="IkonovePismo">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="Karta" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="Nadpis" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="Podnadpis" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Popis" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="VelkeCislo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Ikona" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IkonovePismo}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- tlačidlo vzorového súboru na stiahnutie (Import a export, sprievodca importom) -->
            <DataTemplate x:Key="TlacidloVzoru">
                <Button Margin="0,0,10,10" Padding="14,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding DataContext.StiahnutVzorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding Subor, StringFormat=Uložiť súbor {0} do priečinka Stiahnuté}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IkonovePismo}" Text="&#xE896;" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subor}" FontSize="12" />
                            <TextBlock Text="{Binding Popis}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- jedna úloha v zozname (časť Úlohy, dashboard, karta položky; DataContext zoznamu má príkaz PrepnutHotovo) -->
            <DataTemplate x:Key="UlohaRiadok">
                <DockPanel Margin="0,2">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Hotovo, Mode=OneWay}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"
                              Command="{Binding DataContext.PrepnutHotovoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" ToolTip="Označiť ako hotovú alebo znova otvoriť" />
                    <Border x:Name="Termin" DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding TerminText, Converter={StaticResource NieJePrazdne}}">
                        <TextBlock x:Name="TerminText" Text="{Binding TerminText}" FontSize="11.5" />
                    </Border>
                    <TextBlock x:Name="Priorita" DockPanel.Dock="Left" Text="!" FontWeight="Bold" Width="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Hidden" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Text" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PolozkaText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding PolozkaText, Converter={StaticResource NieJePrazdne}}" />
                    </StackPanel>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Vysoka}" Value="True">
                        <Setter TargetName="Priorita" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Nizka}" Value="True">
                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Dnes}" Value="True">
                        <Setter TargetName="Termin" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter TargetName="TerminText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PoTermine}" Value="True">
                        <Setter TargetName="Termin" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter TargetName="TerminText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        <Setter TargetName="TerminText" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Hotovo}" Value="True">
                        <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough" />
                        <Setter TargetName="Text" Property="Opacity" Value="0.55" />
                        <Setter TargetName="Termin" Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="Stitok" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
