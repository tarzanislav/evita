<UserControl x:Class="Evita.Views.UlohyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Filter" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Filter}" GroupName="filterUloh" Content="Otvorené" IsChecked="{Binding JeOtvorene}" />
                <RadioButton Style="{StaticResource Filter}" GroupName="filterUloh" Content="Hotové" IsChecked="{Binding JeHotove}" />
                <RadioButton Style="{StaticResource Filter}" GroupName="filterUloh" Content="Všetky" IsChecked="{Binding JeVsetky}" />
                <Button Content="Vymazať hotové…" Padding="12,5" Margin="10,0,0,0" Command="{Binding VymazatHotoveCommand}"
                        IsEnabled="{Binding SuHotove}" />
            </StackPanel>
            <TextBlock Text="Úlohy" Style="{StaticResource Nadpis}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <!-- rýchle pridanie -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Karta}" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="8,0,0,0"
                        Command="{Binding PridatCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Pridať" />
                    </StackPanel>
                </Button>
                <ComboBox DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" ItemsSource="{Binding Priority}" DisplayMemberPath="Nazov"
                          SelectedValuePath="Hodnota" SelectedValue="{Binding NovaPriorita}" ToolTip="Priorita" />
                <DatePicker DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" SelectedDate="{Binding NovyTermin}" ToolTip="Termín (nepovinný)" />
                <Grid>
                    <TextBox x:Name="PoleNova" Text="{Binding NovyText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PridatCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Čo treba urobiť? Napíšte a stlačte Enter" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding NovyText, Converter={StaticResource NieJePrazdne}, ConverterParameter=opacne}" />
                </Grid>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Suhrn}" Style="{StaticResource Popis}" Margin="2,8,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Karta}" Padding="6">
                <Grid>
                    <TextBlock Text="Žiadne úlohy." Style="{StaticResource Popis}" FontSize="13" Margin="10"
                               Visibility="{Binding Zoznam.Count, Converter={StaticResource NulaNaViditelnost}}" />
                    <ListBox ItemsSource="{Binding Zoznam}" SelectedItem="{Binding Vybrana}" ItemTemplate="{StaticResource UlohaRiadok}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- podrobnosti -->
            <Border Grid.Column="2" Style="{StaticResource Karta}" VerticalAlignment="Top">
                <Grid>
                    <TextBlock Text="Vyberte úlohu v zozname – tu ju môžete upraviť, doplniť termín, popis alebo naviazať na položku."
                               Style="{StaticResource Popis}" FontSize="13"
                               Visibility="{Binding JeVybrana, Converter={StaticResource InverzBoolNaViditelnost}}" />
                    <StackPanel Visibility="{Binding JeVybrana, Converter={StaticResource BoolNaViditelnost}}">
                        <TextBlock Text="Úloha" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                        <CheckBox Content="Hotovo" IsChecked="{Binding Hotovo}" Margin="0,10,0,0" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Termín" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding Termin}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Dnes" Padding="8,2" Command="{Binding TerminDnesCommand}" />
                                    <Button Content="Bez termínu" Padding="8,2" Margin="4,0,0,0" Command="{Binding TerminZrusitCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Priorita" Style="{StaticResource Stitok}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Priority}" DisplayMemberPath="Nazov" SelectedValuePath="Hodnota" SelectedValue="{Binding Priorita}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Položka (prírastkové číslo, nepovinné)" Style="{StaticResource Stitok}" Margin="0,12,0,4" />
                        <DockPanel>
                            <TextBox Width="90" Text="{Binding PolozkaCislo, UpdateSourceTrigger=PropertyChanged}" />
                            <Button DockPanel.Dock="Right" Content="Otvoriť…" Padding="10,4" Margin="6,0,0,0" Command="{Binding OtvorPolozkuCommand}" />
                            <TextBlock Text="{Binding PolozkaText}" Style="{StaticResource Popis}" FontSize="13" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>

                        <TextBlock Text="Popis" Style="{StaticResource Stitok}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding Popis, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="{Binding InfoText}" Style="{StaticResource Popis}" Margin="0,10,0,0" />

                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Left" Content="Vymazať" MinWidth="100" Command="{Binding VymazatCommand}" />
                            <Button Content="Uložiť" MinWidth="120" HorizontalAlignment="Right" Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding UlozitCommand}" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
