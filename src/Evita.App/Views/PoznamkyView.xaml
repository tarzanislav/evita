<UserControl x:Class="Evita.Views.PoznamkyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Evita.Views">
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding UlozitCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NovaPoznamkaCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- zoznam -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" VerticalAlignment="Center"
                        Command="{Binding NovaPoznamkaCommand}" ToolTip="Nová poznámka (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Ikona}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Nová poznámka" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Poznámky" Style="{StaticResource Nadpis}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="PoleHladat" Text="{Binding Hladat, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="30,5,30,5" />
                <TextBlock Style="{StaticResource Ikona}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" HorizontalAlignment="Left"
                           IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Hľadať v poznámkach" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding Hladat, Converter={StaticResource NieJePrazdne}, ConverterParameter=opacne}" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Suhrn}" Style="{StaticResource Popis}" Margin="2,8,0,0" />

            <Grid>
                <TextBlock Text="Zatiaľ žiadne poznámky. Vytvorte prvú tlačidlom Nová poznámka." Style="{StaticResource Popis}" FontSize="13" Margin="4,8"
                           Visibility="{Binding Zoznam.Count, Converter={StaticResource NulaNaViditelnost}}" />
                <ListBox x:Name="Zoznam" ItemsSource="{Binding Zoznam}" SelectedItem="{Binding Vybrana}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" BorderThickness="5,0,0,0" Padding="10,7,8,7"
                                    BorderBrush="{Binding Farba, Converter={StaticResource FarbaNaStetec}}"
                                    Background="{Binding Farba, Converter={StaticResource FarbaNaStetec}, ConverterParameter=30}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Padding="4" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.PrepnutPripnutieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Pripnúť alebo odopnúť">
                                        <TextBlock x:Name="Spendlik" Style="{StaticResource Ikona}" Text="&#xE718;" FontSize="12" Opacity="0.3" />
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Nahlad}" Style="{StaticResource Popis}" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Nahlad, Converter={StaticResource NieJePrazdne}}" />
                                        <WrapPanel Margin="0,3,0,0">
                                            <TextBlock Text="{Binding ZmeneneText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Visibility="{Binding MaDatum, Converter={StaticResource BoolNaViditelnost}}">
                                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE787;" FontSize="11" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding DatumText}" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Visibility="{Binding MaPolozku, Converter={StaticResource BoolNaViditelnost}}"
                                                        ToolTip="{Binding PolozkaText}">
                                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE8FD;" FontSize="11" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding PolozkaText}" FontSize="11" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding MaUdalost, Converter={StaticResource BoolNaViditelnost}}"
                                                        ToolTip="{Binding UdalostText}">
                                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE823;" FontSize="11" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding UdalostText}" FontSize="11" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Pripnuta}" Value="True">
                                    <Setter TargetName="Spendlik" Property="Opacity" Value="1" />
                                    <Setter TargetName="Spendlik" Property="Text" Value="&#xE840;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- úprava -->
        <Grid Grid.Column="2">
            <TextBlock Text="Vyberte poznámku zo zoznamu alebo vytvorte novú." Style="{StaticResource Popis}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding JeEditor, Converter={StaticResource InverzBoolNaViditelnost}}" />
            <DockPanel DataContext="{Binding Editor}"
                       Visibility="{Binding DataContext.JeEditor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolNaViditelnost}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="neuložené zmeny" Style="{StaticResource Popis}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding Zmenena, Converter={StaticResource BoolNaViditelnost}}" />
                        <Button Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Command="{Binding UlozitCommand}" ToolTip="Uložiť (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Uložiť" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6" Margin="6,0,0,0" Command="{Binding VymazatCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ikona}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Vymazať" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Titulok}" Style="{StaticResource Podnadpis}" Margin="0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <v:PoznamkaEditor x:Name="Editor" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
