<Window x:Class="Evita.Views.HesloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heslo zálohy"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Nadpis" Style="{StaticResource Podnadpis}" Text="Heslo zálohy" />
        <TextBlock x:Name="Popis" TextWrapping="Wrap" Margin="0,0,0,8" />

        <TextBlock Text="Heslo" Style="{StaticResource Stitok}" />
        <PasswordBox x:Name="Heslo1" />

        <StackPanel x:Name="PanelOpakovanie">
            <TextBlock Text="Heslo znova" Style="{StaticResource Stitok}" />
            <PasswordBox x:Name="Heslo2" />
        </StackPanel>

        <TextBlock x:Name="Chyba" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="100" Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Zrušiť" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
