<Window x:Class="Evita.Views.VstupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Otazka" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="Pole" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="100" Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Zrušiť" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
